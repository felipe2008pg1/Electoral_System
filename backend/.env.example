# Copy to backend/.env and fill with real values. Never commit backend/.env.
POSTGRES_USER=electoral
POSTGRES_PASSWORD=
POSTGRES_DB=electoral_system
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Used for HMAC of CPF (voter_hash). Generate with: openssl rand -hex 32
# This alone does NOT make CPF hashing safe against low-entropy brute force —
# see security note in CHANGELOG_AI.md / DECISIONS.md.
VOTER_HMAC_SECRET=

# Comma-separated. Leave empty only in local dev — MUST be set in production.
ALLOWED_ORIGINS=

APP_ENV=development
DEBUG=false
